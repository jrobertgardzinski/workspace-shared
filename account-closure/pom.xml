<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jrobertgardzinski</groupId>
    <artifactId>account-closure</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <!--
      The words five services must agree on to close one account: the name of every message the
      saga sends, and who asked for the closure.

      They were literals. Identity had an enum, the orchestrator had constants in a final class,
      and each content service had a `private static final String BY_ADMIN = "ADMIN"` of its own —
      five spellings of one agreement, none of which can be changed without finding the other four.
      A typo in any of them is not a compile error anywhere: it is a command nobody acts on, or a
      leaver's erasure quietly carried out under an administrator's conditions.

      Since 2026-09-24 it also holds ClosureCommand: the parsed form of those same fields, which
      three participants were each about to declare for themselves. That is still vocabulary —
      the day the agreement gains a field, one of the three would have been the one that forgot.

      Since 2026-09-28 it also holds the PROTOCOL itself, not only its words: ClosureOutcome (one
      shape for what a participant did, where three services each had their own), and the
      ClosureParticipant / AtomicClosureParticipant skeleton — the guard in front of the three
      commands, the switch between them, and the mark that commits together with its confirmation.
      Those were copied word for word into three participants and had already drifted in the one
      way nobody sees: the wording of a log line. The contract tests below held all three to the
      same promises; the skeleton is that agreement on the production side.

      What is NOT here: the envelope, the topics, the policy object, the route a confirmation
      takes, or anything else about HOW a message travels. Those differ per deployment (ADR: Source/Destination, not topics) and per
      service. Nor the conditions a closure may carry: what those WORDS mean is the portal's
      business and lives in portal-libs/purge-rule, which is why the skeleton hands the whole
      command to the participant and lets it read its own axis. Pure Java, only user-id,
      unit-of-work and slf4j beside it, so Micronaut, Spring and Quarkus consumers can all hold it.
    -->
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <!-- the promise the mark and its confirmation commit together -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>unit-of-work</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <!-- the leaver's identity: the one type this vocabulary shares with everybody -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>user-id</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <!-- the estate's logging front: the skeleton drops a command that names nobody, and a
                 drop nobody can see is the failure mode. Logged under the PARTICIPANT's own name
                 (getClass()), so the services' log tests and an operator's grep still find it. -->
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>2.29.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- the participant contract travels to the three participants as a test-jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.17.0</version>
            </plugin>
        </plugins>
    </build>
</project>
